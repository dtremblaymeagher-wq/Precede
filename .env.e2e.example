# Copy this file to .env.e2e and fill in real values.
# NEVER commit .env.e2e — it contains credentials.

# Staging URL (default: Railway staging environment)
E2E_BASE_URL=https://precede-automated-test.up.railway.app

# User A — primary test account (must exist in Clerk + staging Supabase)
E2E_USER_A_EMAIL=e2e-user-a@example.com
E2E_USER_A_PASSWORD=

# User B — second account for isolation tests (optional)
# If not set, Flow 4 (isolation) is automatically skipped.
E2E_USER_B_EMAIL=e2e-user-b@example.com
E2E_USER_B_PASSWORD=

# Set to "true" to enable Jira round-trip tests in Flow 3
# Requires a real Jira sandbox configured in the staging instance
E2E_JIRA_ENABLED=false
